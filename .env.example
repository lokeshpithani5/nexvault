# ==============================================================================
# NEXVAULT CONTROL PLANE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True
APP_NAME=NEXVAULT Control Plane
APP_VERSION=1.0.0

# Server Binding
HOST=127.0.0.1
PORT=8000

# PostgreSQL Metadata Database URL
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# Fallback for zero-dependency local verification: sqlite+aiosqlite:///./nexvault_metadata.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/nexvault_metadata

# Fallback SQLite DB when local PostgreSQL daemon is unavailable
ENABLE_SQLITE_FALLBACK=True
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./nexvault_metadata.db

# Security & JWT Token Authentication
# Generate a cryptographically secure key: `openssl rand -hex 32`
SECRET_KEY=nexvault-super-secret-development-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@nexvault.internal
INITIAL_ADMIN_PASSWORD=AdminSecurePassword2026!
INITIAL_ADMIN_NAME=NexVault System Administrator

# CORS Configuration (Comma-separated origins for React frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Storage Node Ports & Topology
# 6 Independent Daemons: Ports 5001-5003 (Zone A), 5004-5006 (Zone B)
STORAGE_NODE_HOST=127.0.0.1
STORAGE_NODE_PORTS=5001,5002,5003,5004,5005,5006
STORAGE_DIR_BASE=./storage

# Background Health & Self-Healing Worker Parameters
HEALTH_CHECK_INTERVAL_SECONDS=3.0
REPAIR_WORKER_INTERVAL_SECONDS=5.0
INTEGRITY_SCAN_INTERVAL_SECONDS=30.0
REBALANCE_THRESHOLD_PERCENT=20.0
